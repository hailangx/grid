{
  "name": "grid",
  "displayName": "Grid",
  "description": "Replace the default terminal split view with a configurable grid of terminals",
  "version": "0.2.0",
  "publisher": "hailangx",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://github.com/hailangx/grid#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/hailangx/grid.git"
  },
  "bugs": {
    "url": "https://github.com/hailangx/grid/issues"
  },
  "keywords": [
    "terminal",
    "grid",
    "split",
    "multi-terminal",
    "xterm"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onTerminalProfile:grid.profile"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "grid.open",
        "title": "Open Grid",
        "category": "Grid",
        "icon": "$(terminal)"
      },
      {
        "command": "grid.addTerminal",
        "title": "Add Terminal to Grid",
        "category": "Grid"
      },
      {
        "command": "grid.toggleIntercept",
        "title": "Toggle Intercept New Terminals",
        "category": "Grid"
      },
      {
        "command": "grid.closeAllTerminals",
        "title": "Close All Terminals",
        "category": "Grid"
      },
      {
        "command": "grid.renameGrid",
        "title": "Rename Grid Tab",
        "category": "Grid"
      }
    ],
    "terminal": {
      "profiles": [
        {
          "id": "grid.profile",
          "title": "Grid",
          "icon": "terminal"
        }
      ]
    },
    "keybindings": [
      {
        "command": "grid.open",
        "key": "ctrl+shift+`",
        "mac": "cmd+shift+`"
      }
    ],
    "configuration": {
      "title": "Grid",
      "properties": {
        "grid.defaultShell": {
          "type": "string",
          "default": "",
          "description": "Default shell to use. Leave empty to use system default."
        },
        "grid.initialCount": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 16,
          "description": "Number of terminals to create when opening the grid."
        },
        "grid.fontSize": {
          "type": "number",
          "default": 13,
          "minimum": 8,
          "maximum": 32,
          "description": "Font size for terminals in the grid."
        },
        "grid.fontFamily": {
          "type": "string",
          "default": "'Cascadia Code', 'Fira Code', Menlo, Monaco, monospace",
          "description": "Font family for terminals in the grid."
        },
        "grid.interceptNewTerminals": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, new terminals opened by extensions or tasks are redirected into Grid."
        },
        "grid.maxTerminalsPerGrid": {
          "type": "number",
          "default": 9,
          "minimum": 1,
          "maximum": 25,
          "description": "Maximum number of terminals per grid tab. A new grid tab is created when this limit is reached."
        },
        "grid.showCwdInTitle": {
          "type": "boolean",
          "default": true,
          "description": "Show the current working directory in each terminal's title bar."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "build": "node esbuild.js --production",
    "check": "tsc --noEmit",
    "package": "vsce package"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
